{
  "version": 1,
  "providers": [
    {
      "id": "litellm-gateway",
      "displayName": "Your LiteLLM Gateway",
      "kind": "openai-compatible",
      "ownedBy": "user",
      "baseUrl": "http://127.0.0.1:4000/v1",
      "baseUrlEnv": "CODEX_ROUTER_LITELLM_BASE_URL",
      "configurableBaseUrl": true,
      "autoCurateDiscoveredModels": true,
      "importLiveModelMetadata": true,
      "directResponses": true,
      "defaultApiSurface": "chat-completions",
      "apiSurfaceOverrides": [
        {
          "prefix": "codex-gpt-",
          "apiSurface": "responses"
        }
      ],
      "planNote": "Uses your own trusted LiteLLM endpoint and virtual key. Discovered models are added automatically and are never pruned automatically.",
      "credential": {
        "environment": [
          "CODEX_ROUTER_LITELLM_API_KEY"
        ],
        "file": "litellm-gateway-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-litellm-gateway"
        ],
        "prompt": "LiteLLM virtual key",
        "label": "virtual key"
      }
    }
  ]
}
