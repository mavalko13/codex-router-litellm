{
  "name": "codex-model-router",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Extensible local model router for Codex and Cursor",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node scripts-check.mjs",
    "test": "node --test test/*.test.mjs",
